config watchplug 'main'
	option enabled '0'
	option interval '1m'
	list targets '1.1.1.1'
	list targets '9.9.9.9'
	list targets '8.8.8.8'
	option wan_iface 'wan'
	option ping_count '2'
	option ping_timeout '3s'
	option down_time '20m'
	option boot_delay '5m'
	option recovery_grace '10m'
	option backoff '0'
	option backoff_max '4h'
	option limit_cycles '0'
	option max_cycles '3'

config plug 'plug'
	option preset 'tasmota'
	option host ''
	option port '80'
	option relay 'Power'
	option user ''
	option password ''
	option off_time '30s'
	option http_timeout '5s'
	option enforce_poweronstate '1'
	# preset 'custom' only; {host} {port} {user} {password} {off_time} {off_ds}
	option url_on ''
	option url_off ''
	option url_cycle ''
	option url_state ''
	option state_key ''
