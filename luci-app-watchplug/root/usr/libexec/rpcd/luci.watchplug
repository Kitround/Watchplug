#!/bin/sh
# ubus backend for the Watchplug LuCI view -- every method delegates to /usr/sbin/watchplug.

# Section names look like @device[0] and the brackets are a glob character class.
# Nothing here is meant to match a filename, so pathname expansion is switched off.
set -f

. /usr/share/libubox/jshn.sh

BIN=/usr/sbin/watchplug

reply() { # reply <ok 0|1> <output>
	json_init
	json_add_boolean ok "$1"
	json_add_string output "$(echo "$2" | tr -d '\n' | tr -d '"')"
	json_dump
}

run() {
	out=$("$@" 2>&1)
	rc=$?
	[ $rc -eq 0 ] && reply 1 "$out" || reply 0 "$out"
}

# The device argument names a uci section and is reachable by anyone holding the
# write ACL, so it is checked rather than trusted. It cannot inject a command --
# the CLI only ever expands it inside quotes -- but an unchecked value would let a
# caller aim uci reads at arbitrary paths under the watchplug config.
# Empty means "every configured device", which is what the CLI does with no argument.
device_arg() {
	case "$1" in
	'') return 0 ;;
	@device\[*\] | [a-zA-Z_]*) : ;;
	*) return 1 ;;
	esac
	case "$1" in
	*[!a-zA-Z0-9_@\[\]]*) return 1 ;;
	esac
	return 0
}

# read_device <json input> : the optional "device" member, validated
read_device() {
	read -r input
	json_load "$input" 2>/dev/null || return 1
	json_get_var device device
	json_get_var state state
	device_arg "$device"
}

case "$1" in
list)
	json_init
	json_add_object status
	json_close_object
	json_add_object check
	json_close_object
	json_add_object logs
	json_close_object
	json_add_object clear_logs
	json_close_object
	json_add_object power
	json_add_string state ""
	json_add_string device ""
	json_close_object
	json_add_object cycle
	json_add_string device ""
	json_close_object
	json_add_object rearm
	json_close_object
	json_add_object fix_poweronstate
	json_add_string device ""
	json_close_object
	json_dump
	;;
call)
	case "$2" in
	status)
		$BIN status
		;;
	logs)
		# jshn does the quoting, so newlines survive the trip to the browser
		json_init
		json_add_string log "$($BIN logs 200)"
		json_dump
		;;
	check)
		if out=$($BIN check 2>&1); then
			json_init
			json_add_boolean online 1
		else
			json_init
			json_add_boolean online 0
		fi
		json_add_string output "$(echo "$out" | tr -d '\n"')"
		json_dump
		;;
	power)
		if ! read_device; then
			reply 0 "invalid device"
		else
			case "$state" in
			on | off) run $BIN power "$state" "$device" ;;
			*) reply 0 "invalid state" ;;
			esac
		fi
		;;
	cycle)
		if read_device; then
			run $BIN cycle "$device"
		else
			reply 0 "invalid device"
		fi
		;;
	fix_poweronstate)
		if read_device; then
			run $BIN fix-poweronstate "$device"
		else
			reply 0 "invalid device"
		fi
		;;
	clear_logs) run $BIN clear-logs ;;
	rearm) run $BIN rearm ;;
	*) reply 0 "unknown method" ;;
	esac
	;;
esac
